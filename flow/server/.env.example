# Servidor
PORT=3000
ALLOWED_ORIGIN=*

# Mercado Pago
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# Use credenciais de teste (TEST-...) ou produção (APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do backend (necessária para Webhook do Mercado Pago em produção, ex: https://seu-app.onrender.com)
PUBLIC_BACKEND_URL=http://localhost:3000

# Telegram (Fase 2 - Automação da Licença)
# Crie seu bot no @BotFather e cole o token aqui
TELEGRAM_BOT_TOKEN=
# Chat ID do fornecedor ou do seu canal/grupo
TELEGRAM_SUPPLIER_CHAT_ID=
# Comando a enviar ao fornecedor (suporta {order_id}, {product_id}, {customer_email})
TELEGRAM_COMMAND_TEMPLATE=/comprar {product_id}

# 3D Library & Supabase (Sincronizador WhatsApp -> 3D-Project)
SUPABASE_URL=https://eqhxwpgpzseprcmiuaww.supabase.co
SUPABASE_ANON_KEY=sb_publishable_P_uamf5YKN2AFGyTJP3QTA_VrijCGgw
# Chave service_role (Supabase Dashboard -> Project Settings -> API Keys -> service_role secret)
# Necessária para envio direto do robô para o bucket 'modelos' e tabela 'models' no Supabase
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_USER_ID=a25a3db7-e996-47c8-869f-3c167f26cf1e
SUPABASE_AUTHOR=Bruno T.

# Mercado Livre (Piloto Automático de Vendas)
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# GGBuilder / Fornecedor Parceiro de Licenças
GGBUILDER_API_KEY=

