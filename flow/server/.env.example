# Servidor
PORT=3000
ALLOWED_ORIGIN=*

# Mercado Pago
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# Use credenciais de teste (TEST-...) ou produção (APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do backend (necessária para Webhook do Mercado Pago em produção, ex: https://seu-app.onrender.com)
PUBLIC_BACKEND_URL=http://localhost:3000

# Telegram (Fase 2 - Automação da Licença)
# Crie seu bot no @BotFather e cole o token aqui
TELEGRAM_BOT_TOKEN=
# Chat ID do fornecedor ou do seu canal/grupo
TELEGRAM_SUPPLIER_CHAT_ID=
# Comando a enviar ao fornecedor (suporta {order_id}, {product_id}, {customer_email})
TELEGRAM_COMMAND_TEMPLATE=/comprar {product_id}
